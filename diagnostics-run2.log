      ToolDefinitions / query_crm JSON Schema:
      [
        {
          "name": "query_crm",
          "description": "THE only CRM read tool. Query approved entities from the catalog. Supports list/count/aggregate with filters/sort/dates/limit, aggregatesJson\u002BgroupByJson, relatedFromEntity\u002BrelatedFromId GUID filters, and linksJson for related-entity joins (max depth 2 / max 3 linked entities). Pass a complete structured plan \u2014 never OData/SQL/FetchXML. Include every filter, date range, field, sort, and relationship the user requested.",
          "jsonSchema": {
            "type": "object",
            "properties": {
              "entity": {
                "description": "Approved entity logical name from the catalog (or configured alias).",
                "type": "string"
              },
              "operation": {
                "description": "list | count | aggregate \u2014 choose from the user\u0027s requested result shape.",
                "type": "string",
                "default": "list"
              },
              "selectJson": {
                "description": "Optional JSON array of field names to select (list only).",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "filtersJson": {
                "description": "JSON array of filters: [{field,operator,value}] max 3. DateTime fields accept ISO values with operators eq|ne|gt|ge|lt|le.",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "relativeDateField": {
                "description": "Approved DateTime field for a structured date range (e.g. createdon, modifiedon).",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "relativeDateToken": {
                "description": "Legacy fixed tokens only: last_calendar_month | this_calendar_month | this_week | last_7_days | last_30_days | last_6_calendar_months. Prefer dateRangeJson for arbitrary periods.",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "dateRangeJson": {
                "description": "Preferred structured date range JSON object used with relativeDateField. Kinds: absolute {start,endExclusive ISO}, last_n_days|last_n_weeks|last_n_calendar_months|last_n_rolling_months|last_n_years {n}, this_calendar_month|this_calendar_quarter|this_calendar_year (YTD)|this_week, previous_calendar_month|previous_calendar_quarter|previous_calendar_year, calendar_year {year}, calendar_quarter {year,quarter}, calendar_month_range {year,monthStart,monthEnd}. Half-open [start,endExclusive). Backend resolves relative kinds with the business timezone. If the user asks for an ambiguous period (e.g. \u0027six months within 2025\u0027 without which months), ask clarification instead of guessing.",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "sortJson": {
                "description": "JSON array of sorts: [{field,direction}] max 2.",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "sortField": {
                "description": "Sort field logical name from approved metadata.",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "sortDirection": {
                "description": "asc or desc.",
                "type": [
                  "string",
                  "null"
                ],
                "default": "desc"
              },
              "limit": {
                "description": "Max rows 1-50 for list.",
                "type": "integer",
                "default": 10
              },
              "relatedFromEntity": {
                "description": "Parent entity for one-hop relationship filter.",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "relatedFromId": {
                "description": "Parent record GUID for one-hop relationship filter.",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "aggregatesJson": {
                "description": "JSON array of aggregates for reports: [{function:count|sum|avg|min|max, field, alias}] max 3. Required when operation=aggregate.",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "groupByJson": {
                "description": "JSON array of groupBy for reports: [{field, alias, dateGrouping?:year|month|day|week|quarter}] max 3.",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "linksJson": {
                "description": "JSON array of related-entity links: [{entity, relationship?, joinType?:outer|inner, alias?, select?:[fields], filters?:[{field,operator,value}], links?:[nested]}]. Set relationship to the catalog SchemaName matching the intended business relationship displayName when known. Nested links max depth 2.",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              }
            },
            "required": [
              "entity"
            ]
          }
        }
