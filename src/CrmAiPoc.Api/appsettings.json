{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "CrmAiPoc.Api": "Debug"
    }
  },
  "Ai": {
    "Provider": "Groq",
    "ProviderTimeoutSeconds": 60,
    "MaxUserQuestionsInHistory": 10,
    "MaxUserHistoryCharacters": 8000,
    "MaxQueryPlanCorrectionRetries": 2,
    "MaxSchemaDiscoveryCallsPerRequest": 2,
    "MaxSchemaDiscoveryCandidatesPerConcept": 5,
    "Ollama": {
      "BaseUrl": "http://192.168.1.6:11434",
      "Model": "qwen3.5:4b-q4_K_M",
      "ContextSize": 16384,
      "Temperature": 0,
      "EnableThinking": false
    }
  },
  "Gemini": {
    "ModelName": "gemini-3.8-flash"
  },
  "OpenAI": {
    "ModelName": "gpt-4o-mini"
  },
  "Groq": {
    "Model": "openai/gpt-oss-120b",
    "ReasoningEffort": "medium",
    "Temperature": 0,
    "BaseUrl": "https://api.groq.com/openai/v1"
  },
  "OpenRouter": {
    "Model": "openai/gpt-4o",
    "Temperature": 0,
    "BaseUrl": "https://openrouter.ai/api/v1"
  },
  "OllamaEmbeddings": {
    "BaseUrl": "http://192.168.1.6:11434",
    "EmbeddingModel": "nomic-embed-text",
    "ExpectedDimensions": 768,
    "TimeoutSeconds": 120
  },
  "SemanticMetadata": {
    "EnableHybridRetrieval": true,
    "LexicalWeight": 0.55,
    "SemanticWeight": 0.45,
    "MinSemanticSimilarity": 0.32,
    "SemanticCandidatePoolSize": 40,
    "TopKEntities": 3,
    "TopKAttributesPerEntity": 20,
    "TopKRelationships": 10,
    "MinSimilarity": 0,
    "EnableDiagnosticEndpoint": false,
    "EnableDiskCache": true,
    "CacheDirectory": "Cache/SemanticIndex",
    "EmbeddingBatchSize": 16,
    "IndexFailureCooldownSeconds": 90,
    "WarmIndexOnStartup": true
  },
  "Crm": {
    "Provider": "Dynamics365",
    "EnableLiveIntegration": true,
    "BaseUrl": "https://ecrmdev9.te.eg/ECRMpro/api/data/v9.1/",
    "UseDefaultCredentials": true,
    "AllowSendApprovedMetadataCatalogToAi": false,
    "WarmApprovedMetadataOnStartup": true,
    "RestrictToLoopback": true,
    "BusinessTimeZoneId": "Africa/Cairo",
    "MetadataCacheSeconds": 3600,
    "ApprovedEntities": [
      "account",
      "contact",
      "salesorder",
      "product"
    ],
    "ApprovedRelationships": [],
    "EntityAliases": {
      "account": [ "accounts", "customers", "customer account", "customer accounts" ],
      "contact": [ "contacts", "contact persons", "primary contact", "primary contacts" ],
      "salesorder": [ "sales order", "sales orders", "orders" ],
      "lead": [ "leads", "prospects" ],
      "opportunity": [ "opportunities", "opportunity", "deals" ],
      "quote": [ "quotes" ],
      "invoice": [ "invoices" ],
      "salesorderdetail": [ "order lines", "sales order lines", "order details" ],
      "product": [ "products" ],
      "campaign": [ "campaigns", "marketing campaigns" ],
      "te_serviceorder": [ "service orders", "service order" ]
    },
    "RelationshipLabels": {
      "te_account_salesorder_customeraccountid": "Customer Account",
      "order_customer_accounts": "Potential Customer (Account)",
      "te_account_salesorder_branchaccountid": "Branch Account",
      "te_account_salesorder_customerbranchaccountid": "Customer Branch Account",
      "te_account_salesorder_calculated": "Calculated Account",
      "contact_customer_accounts": "Account Contacts",
      "account_primary_contact": "Primary Contact",
      "order_customer_contacts": "Potential Customer (Contact)",
      "te_contact_salesorder_billingcontactid": "Billing Contact",
      "te_contact_salesorder_technicalcontactid": "Technical Contact"
