{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CrmAiPoc.Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Provider": "Groq"
  },
  "Gemini": {
    "ModelName": "gemini-3.8-flash"
  },
  "OpenAI": {
    "ModelName": "gpt-4o-mini"
  },
  "Groq": {
    "ModelName": "openai/gpt-oss-120b",
    "BaseUrl": "https://api.groq.com/openai/v1"
  },
  "Crm": {
    "Provider": "Mock",
    "EnableLiveIntegration": false,
    "BaseUrl": "https://ecrmdev9.te.eg/ECRMBSS/api/data/v9.1/",
    "UseDefaultCredentials": true,
    "AllowSendApprovedMetadataCatalogToAi": true,
    "AiMetadataCatalogMaxEntities": 12,
    "AiMetadataCatalogMaxAttributesPerEntity": 16,
    "AiMetadataCatalogMaxChars": 12000,
    "WarmApprovedMetadataOnStartup": true,
    "RestrictToLoopback": true,
    "BusinessTimeZoneId": "Africa/Cairo",
    "DefaultPageSize": 10,
    "MaxPageSize": 25,
    "MetadataCacheSeconds": 3600,
    "ApprovedEntities": [ "account", "contact", "salesorder", "lead" ],
    "ApprovedRelationships": [],
    "EntityAliases": {
      "account": [ "accounts", "customers", "customer account", "customer accounts" ],
      "contact": [ "contacts", "contact persons", "primary contact", "primary contacts" ],
      "salesorder": [ "sales order", "sales orders", "orders" ],
      "lead": [ "leads", "prospects" ]
    },
    "MockUserId": "demo-user",
    "MockUserDisplayName": "Demo CRM User"
  }
}
