  },
  "AggregatePartition": {
    "MaxPartitions": 120,
    "MaxDepth": 3,
    "TimeoutSeconds": 120,
    "MaxSingleYearPartitions": 12,
    "YearChunkSize": 3,
    "MaxDegreeOfParallelism": 3
  }
